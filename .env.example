# labs.to: settings and secrets for THIS machine. Copy to .env.labs and fill in what you need:
#
#   pnpm doctor --init       creates .env.labs from this file (git-ignored, mode 600)
#   pnpm doctor --for ios    says what is still missing for iOS releases
#
# A real environment variable always wins over this file. Nothing in .env.labs is ever
# committed (.gitignore, and the secrets scan refuses it). Prefer file paths and
# 1Password references (op://...) to pasting a secret here.
#
# This is not the Next.js app's .env.local (apps/<idea>/web/.env.local): that one holds the
# app's own local settings, this one holds what the release tooling needs.

# ---- iOS: TestFlight (pnpm release <idea> ios) ------------------------------------------
# App Store Connect > Users and Access > Integrations > App Store Connect API: create a key
# (an Admin key is the safe choice), download the .p8 once, and keep it somewhere safe.
ASC_KEY_ID=
ASC_ISSUER_ID=

# The key file: a path to AuthKey_<id>.p8, or a 1Password reference to it. Fill in one.
# With neither, ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8 is used if it exists.
ASC_KEY_PATH=
ASC_KEY_OP_REF=

# Your Apple developer team id (10 characters), for every iOS idea at once.
# Instead, an idea can set DEVELOPMENT_TEAM in its ios/Config/Local.xcconfig.
LABS_APPLE_TEAM_ID=

# ---- Web: Vercel (pnpm release <idea> web) -----------------------------------------------
# vercel.com/account/tokens: create a token. It can deploy to your account, so it is the one
# value here worth keeping out of the file: put an op:// reference instead of the token itself
# (for example op://Private/Vercel/token) and it is read from 1Password when a release needs it.
VERCEL_TOKEN=

# Only if the projects live in a team rather than your personal account: the team id (team_...),
# from the team's Settings.
VERCEL_TEAM_ID=
