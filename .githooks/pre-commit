#!/bin/sh
# Fast guards (well under a second): no secrets in what is being committed, and
# every idea manifest is valid. Slow checks live in `pnpm verify`.
cd "$(git rev-parse --show-toplevel)" || exit 1

node tooling/scan-secrets.mjs --staged || exit 1
node tooling/validate-ideas.mjs > /dev/null || { node tooling/validate-ideas.mjs; exit 1; }
