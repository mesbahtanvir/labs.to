#!/bin/sh
# Refuses to push commits whose exact content has not passed `pnpm verify` on
# this machine. Fails fast instead of running the checks itself, so a push never
# hangs for a minute. `git push --no-verify` bypasses it on purpose.
cd "$(git rev-parse --show-toplevel)" || exit 1

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a branch
  case "$local_ref" in refs/tags/*) continue ;; esac
  node tooling/verify.mjs --check-stamp "$local_sha" || status=1
done
exit $status
