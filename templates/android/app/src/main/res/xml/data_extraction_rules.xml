<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred to a new device: a login session kept in app storage
     is not something to hand around. Opt data in deliberately, per domain, when an idea needs it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
