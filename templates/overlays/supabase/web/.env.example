# Copy to .env.local (git-ignored) and fill in the key.
#   cp .env.example .env.local
#   pnpm sb {{name}} status      # prints the local Publishable key
#
# This idea's local Supabase stack listens on its own port block, so it can run
# next to other ideas' stacks.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:{{api_port}}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put a secret key or the service role key in a NEXT_PUBLIC_ variable:
# NEXT_PUBLIC_ values are shipped to every browser.
